{
  "name": "oveehasnat-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Personal portfolio for Abu Hasnat Ovee — static Next.js on Cloudflare Pages",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm generate && next dev --turbopack",
    "generate": "tsx scripts/generate-static.ts",
    "prebuild": "pnpm generate",
    "build": "next build",
    "start": "serve out -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "links": "node scripts/check-links.mjs",
    "ci": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm test:e2e && pnpm links",
    "build:pages": "NEXT_PUBLIC_BASE_PATH=/portfolio SITE_URL=https://abuhasnat-cb.github.io/portfolio pnpm build",
    "test:e2e:pages": "playwright test -c playwright.pages.config.ts",
    "preview:pages": "node scripts/prepare-pages-preview.mjs && serve .preview -l 4174"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.8.2",
    "lucide-react": "^1.61.0",
    "motion": "^14.5.0",
    "next": "15.5.28",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@lhci/cli": "^0.15.1",
    "@next/eslint-plugin-next": "^15.5.28",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "lighthouse": "^13.5.0",
    "linkinator": "^8.1.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serve": "^14.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
